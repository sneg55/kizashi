{
  "$schema": "../node_modules/testreel/recording-definition.schema.json",
  "url": "https://kizashi.nsawinyh.workers.dev/app",
  "viewport": { "width": 1920, "height": 1080 },
  "colorScheme": "light",
  "outputFormat": "mp4",
  "cursor": { "enabled": true, "size": 28, "color": "#1f1f47", "rippleColor": "#576cdb", "rippleSize": 44, "idleHide": false, "transitionMs": 700 },
  "steps": [
    { "action": "wait", "ms": 2000 },
    { "action": "hover", "selector": "text=portfolio data/demo/portfolio-nj-086.csv" },
    { "action": "wait", "ms": 2000 },
    { "action": "hover", "selector": "text=Business Master File, dated" },
    { "action": "wait", "ms": 2000 },
    { "action": "hover", "selector": "text=held for review by the dispatcher" },
    { "action": "wait", "ms": 2500 },
    { "action": "zoom", "selector": "text=held for review by the dispatcher", "scale": 1.3 },
    { "action": "wait", "ms": 2500 }
  ]
}
