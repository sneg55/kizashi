    { "action": "wait", "ms": 2000 },
    { "action": "click", "selector": "button:has-text(\"group subordinate\")" },
    { "action": "wait", "ms": 2500 },
    { "action": "click", "selector": "button:has-text(\"one missed\")" },
    { "action": "wait", "ms": 2500 },
    { "action": "click", "selector": "button:has-text(\"every reason\")" },
    { "action": "wait", "ms": 1500 },
    { "action": "type", "selector": "input[placeholder=\"Search by name or EIN\"]", "text": "STEINERT", "clear": true },
    { "action": "wait", "ms": 2500 },
    { "action": "type", "selector": "input[placeholder=\"Search by name or EIN\"]", "text": "", "clear": true },
    { "action": "wait", "ms": 1200 },
    { "action": "click", "selector": "button:has-text(\"surface\")" },
